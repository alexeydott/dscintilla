# Delphi needs these prebuilt objects for DLL/static linking.
!/Sources/scibridge32.obj
!/Sources/scibridge64.obj
/Sources/obj/*
!/Sources/obj/sci_combined_bcc64x.o
!/Sources/obj/sci_combined_clang32.o
/c_src/scintilla/win32/obj/
/c_src/lexilla/src/obj/
/c_src/scintilla/bin/*
!/c_src/scintilla/bin/empty.txt
/c_src/lexilla/bin/*
!/c_src/lexilla/bin/empty.txt

# Executables, shared libraries, installers and distribution archives
*.exe
*.exe.old
*.dll
*.so
*.so.*
*.dylib
*.msi
*.msix
*.zip
*.7z
*.rar

# Shipped runtime libraries, viewer plugins and preview-handler installers
